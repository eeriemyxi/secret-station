# Copy to .env before `docker compose up`.
POSTGRES_PASSWORD=change-me-in-production

# Must match the URL the browser uses; the trailing path prefix is required
# because layouts/partials/comments.html loads ${BASE_URL}/comentario.js.
# Production: https://myxi.eu.cc/comentario
BASE_URL=http://localhost:8080/comentario

# Host port for the site.
HTTP_PORT=8080
